# Generated by print-records, and the snapshots its tests compare byte for
# byte: LF on every platform, so a CRLF checkout cannot fail the comparison.
crates/tst-binding-gen/tests/tools/print_records/snapshots/** text eol=lf
bindings/python/src/generated/** text eol=lf
bindings/jvm/src/generated/** text eol=lf
bindings/python/python/tstrans/klv.py text eol=lf
bindings/python/python/tstrans/klv.pyi text eol=lf
# Java files that hold a generated block, by package (a family adds its package here): LF so the block compare is byte for byte
bindings/jvm/src/main/java/org/tstrans/klv/*.java text eol=lf
bindings/jvm/src/main/java/org/tstrans/codec/*.java text eol=lf
bindings/jvm/src/main/java/org/tstrans/srt/*.java text eol=lf
bindings/jvm/src/main/java/org/tstrans/rtp/*.java text eol=lf
bindings/jvm/src/main/java/org/tstrans/mpegts/*.java text eol=lf
