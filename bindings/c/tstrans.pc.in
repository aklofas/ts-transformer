prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
features=@FEATURES@

Name: tstrans
Description: C ABI for the tstrans sender pipeline (MPEG-TS + KLV over SRT)
Version: @VERSION@
Libs: -L${libdir} -ltstrans -lpthread @PLATFORM_LIBS@ -lm
Cflags: -I${includedir}
