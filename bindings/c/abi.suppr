# libabigail suppression file for scripts/check/c/abi-compat.sh.
# The shared library is a Rust cdylib: its DWARF also describes every Rust
# std/core/alloc type and every dependency crate. None of that is the C ABI.
# The C ABI is the exported tst_* functions and TST_*/tst_* variables, and the
# types reachable from them. Nothing else is suppressed.

# Keep only the exported C functions: drop every function whose name is not tst_*
# (Rust-mangled and runtime-support symbols are not the C ABI).
[suppress_function]
  name_not_regexp = ^tst_

# Keep only the exported C variables: drop every variable whose name is not
# tst_* / TST_* (statics and Rust runtime data are not the C ABI).
[suppress_variable]
  name_not_regexp = ^(tst_|TST_)

# The eight enum-valued parameters were retyped from the Rust enum to i32 so an
# out-of-range value is validated instead of being an invalid discriminant.
# The C prototype already declared int32_t (or an int-sized C enum), so callers
# are unaffected; only the library's DWARF parameter type changed.
# This block hides ANY change to these functions' DWARF signature, so
# scripts/check/c/abi-compat.sh pins their header prototypes: the previous
# tag's prototype, with each `# retype:` spelling below replaced by int32_t,
# must equal this tree's, or the rail fails. The rail reads the names, the
# spellings and the expiry from this block; keep them here only.
# Needed only while the comparison baseline predates the change: the rail fails
# once --old-tag is at or after `expires-with-baseline`; delete the block then,
# together with the self-test rows that borrow one of its names
# (tst_sender_config_set_framing_mode in abi-compat-selftest.sh).
[suppress_function]
  # expires-with-baseline: v0.9.1
  # retype: tst_video_codec -> int32_t
  # retype: tst_audio_codec -> int32_t
  # retype: enum tst_klv_stream_type -> int32_t
  # retype: enum tst_ts_framing_mode -> int32_t
  # retype: enum tst_overflow_policy -> int32_t
  # retype: enum tst_reconnect_mode -> int32_t
  change_kind = function-subtype-change
  name_regexp = ^tst_(mux_config_add_(video|klv|audio)_stream|mux_config_add_audio_stream_with_language|sender_config_set_framing_mode|reconnect_policy_set_(overflow_policy|mode)|misp_time_extract)$

# Opaque handle types (`typedef struct X X;` in the header) are not listed here:
# scripts/check/c/abi-compat.sh derives that block from the header on every run
# and appends it to this file's contents.
