@final
class CancelHandle:
    """Cancel handle for `Sender` / `Receiver` / `MuxSender` /
    `DemuxReceiver`. Calling `.cancel()` from any thread wakes a thread
    parked in `.send_bytes()` / `.recv_bytes()` / `.__next__()`; that call
    raises the transport's error class with kind `CLOSED`.

    `is_cancelled()` is SHARED per shell: every handle obtained from the
    same shell, and the shell's own `close()`, flips the same state, so a
    watchdog can observe a cancel issued elsewhere.
    """

    def cancel(self) -> None: ...
    def is_cancelled(self) -> bool: ...
    def __repr__(self) -> str: ...


@final
class OpenCancel:
    """Cancel for opens that have not returned a shell yet.

    Make one before the open and pass it as `cancel=` to `Receiver.open`,
    `DemuxReceiver.open`, `Sender.open`, `MuxSender.open` or the
    `from_url` of the four `tstrans.srt` managed shells; call `cancel()`
    from another thread.

    - One object may be given to any number of opens, one after another
      or at the same time.
    - `cancel()` is sticky: every later open given the object raises
      `CLOSED` before it parses its URL (so a bad URL is reported as
      `CLOSED` too) and opens nothing. The four shell opens raise the
      URL's transport error class (`SrtError`, `RtpError`, `UdpError`,
      `TcpError`, `RistError`); a shell open given a URL whose scheme
      this build does not support still raises `ValueError`. The managed
      `from_url`s are SRT only and raise `SrtError(CLOSED)` whatever the
      URL says. With an already-cancelled object an open is refused with
      `CLOSED` before its configuration and its URL are looked at: an
      open checks the scheme, then the object, then its configuration,
      then the URL, then connects.
    - `cancel()` ends a listener-mode first accept at any time: the open
      raises `SrtError(CLOSED)` and the port is released.
    - It does not interrupt a caller-mode connect, but an open that
      finishes after the cancel raises `CLOSED` and the connection is
      closed again: nothing is handed out.
    - It is not the shell's cancel handle. An open that returned before
      the cancel is untouched by it, a managed receiver's later
      reconnects included; from then on use the shell's
      `cancel_handle()`.

    `cancel()` releases the GIL while it closes listening sockets. Every
    method is safe from any thread, any number of times. The
    interpreter-exit hook still ends a parked first accept, with or
    without this object. Ctrl-C does not interrupt an open parked in a
    first accept; cancel it from another thread through this object.
    """

    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    def is_cancelled(self) -> bool: ...
    def __repr__(self) -> str: ...


@final
class Sender:
    """TS bytes in, any transport out, opened from the transport's URL.

    `Sender.open("srt://host:port?...")` (or `rtp://`, `udp://`, `tcp://`,
    `tcps://`, `rist://`). An `srt://` URL must use `mode=caller` (the
    default); query parameters apply as the transport defines them.
    """

    @classmethod
    def open(cls, url: str, *, cancel: Optional[OpenCancel] = ...) -> Sender:
        """`cancel`: an `OpenCancel` already cancelled raises the transport's
        `CLOSED`; one cancelled during the connect does not interrupt it, but
        the open then raises `CLOSED` and the connection is closed again."""
    def send_bytes(self, data: _BytesLike) -> None:
        """After ``cancel_handle().cancel()`` this raises ``CLOSED``, buffered data included."""
    def flush(self) -> None:
        """After ``cancel_handle().cancel()`` this raises ``CLOSED``, buffered data included.

        A stream of one or two aligned TS packets is not delivered, and
        nothing reports it: the sender forwards bytes only once three
        aligned packets have confirmed the TS alignment. Three or more are
        delivered."""
    def cancel_handle(self) -> CancelHandle: ...
    def socket_stats(self) -> SocketStats: ...
    def srt_stats(self) -> SrtStats:
        """Raises TypeError unless the shell was opened from an srt:// URL."""
    def close(self) -> None: ...
    def finish(self) -> None:
        """Flush the partial and retained bundles, close the transport
        without cancelling first, and raise the flush's error (the
        transport's error class): the lossless end, also over a transport
        that queues (an RTSP push writes its queue, then TEARDOWN). The
        sender is closed either way; a later `finish()` or `close()` does
        nothing, and a `finish()` after `close()` is quiet. Waits behind a
        `send_bytes()` parked on another thread. After
        ``cancel_handle().cancel()`` this raises ``CLOSED``, buffered data
        included.

        A stream of one or two aligned TS packets is not delivered, and
        nothing reports it: the sender forwards bytes only once three
        aligned packets have confirmed the TS alignment. Three or more are
        delivered."""
    def is_alive(self) -> bool: ...
    def __enter__(self) -> Sender: ...
    def __exit__(
        self,
        exc_type: Optional[Type[BaseException]],
        exc_value: Optional[BaseException],
        traceback: Optional[Any],
    ) -> bool: ...
    def __repr__(self) -> str: ...


@final
class Receiver:
    """Any transport in, TS bytes out, opened from the transport's URL.

    `Receiver.open("srt://...?mode=listener")` binds the socket, listens
    and blocks on the first incoming handshake; this is a one-shot accept
    (a later peer needs a fresh `open` or the lower-level `Listener`). The
    datagram and stream transports open their socket. No handle exists
    until the open returns, so the first accept is cancelled through an
    `OpenCancel` passed as `cancel=`: its `cancel()` from another thread
    ends the accept with `SrtError(CLOSED)`.

    Raises:
        SrtError(kind=CONFIG_INVALID): Bad URL, or a non-listener mode.
        SrtError(kind=BROKEN): Any bind or accept fault; the message is
            prefixed `bind: ` or `accept: `.
    """

    @classmethod
    def open(cls, url: str, *, cancel: Optional[OpenCancel] = ...) -> Receiver: ...
    def recv_bytes(self, max_len: Optional[int] = ...) -> bytes:
        """One 188-byte TS packet per call. After ``cancel_handle().cancel()``
        this raises ``CLOSED``, buffered data included. ``max_len`` is
        deprecated and ignored: passing it warns ``DeprecationWarning``;
        removed in 0.12.0."""
    def cancel_handle(self) -> CancelHandle: ...
    def socket_stats(self) -> SocketStats: ...
    def stats(self) -> ReceiverStats:
        """The packets handed out and what sync recovery skipped to find
        them. Waits behind a ``recv_bytes()`` parked on another thread;
        raises the transport's ``CLOSED`` kind after ``close()``."""
    def rtp_stats(self) -> Optional[RtpStats]:
        """The RTP counters of a shell over ``rtp://``; ``None`` on any other
        transport. Never waits behind a call parked on another thread; the
        last value after ``close()``."""
    def srt_stats(self) -> SrtStats:
        """Raises TypeError unless the shell was opened from an srt:// URL."""
    def end_reason(self) -> Optional[EndReason]:
        """The recorded reason, or `None` while the stream is live. Every plain
        receive transport records one."""
    def end_detail(self) -> Optional[str]: ...
    def local_addr(self) -> Optional[Tuple[str, int]]:
        """``(host, port)`` the open bound: a ``udp://``, ``rist://@`` or
        ``rtp://`` bind (the kernel's port when the URL named 0), or an
        ``srt://`` listener once its caller connected (so port 0 cannot
        tell an ``srt://`` caller where to dial). ``None`` for a shell
        whose open records none (a caller, an accepted TCP connection).
        Never waits behind a call parked on another thread; raises the
        transport's ``CLOSED`` once closed."""
    def local_port(self) -> Optional[int]:
        """The port of ``local_addr()``; same rules."""
    def peer_addr(self) -> Optional[Tuple[str, int]]:
        """``(host, port)`` of the sender whose datagram (``udp://``) or
        block (``rist://``) was delivered last; ``None`` until the first
        one, and always ``None`` for a transport that keeps no source
        record (``srt://``, ``tcp://``, ``rtp://``). The host is the IP as
        text (an IPv6 link-local sender's host carries its scope,
        ``fe80::1%2``); an IPv4 sender on a dual-stack bind reads as IPv4.

        It is the source address of the datagrams, which nothing verifies:
        a UDP or RIST sender can forge it. Without a ``source`` key in the
        URL every sender that reaches the receiver is delivered, and this
        names whichever delivered last. Never waits behind a call parked
        on another thread; the last value after ``close()``."""
    def source_rejected(self) -> int:
        """Datagrams or blocks the ``source`` key of a ``udp://`` or
        ``rist://`` URL turned away (``source=<ip>`` admits that IP on any
        port, ``source=first`` the IP of the first delivery until close);
        on ``udp://`` they appear in no received counter. 0 for a
        transport that keeps no source record. Never waits behind a call
        parked on another thread; the last value after ``close()``."""
    def close(self) -> None: ...
    def is_alive(self) -> bool: ...
    def __enter__(self) -> Receiver: ...
    def __exit__(
        self,
        exc_type: Optional[Type[BaseException]],
        exc_value: Optional[BaseException],
        traceback: Optional[Any],
    ) -> bool: ...
    def __repr__(self) -> str: ...


@final
class MuxSender:
    """`Sender` + `Muxer` constructed together, opened from any
    transport's URL.

    Construct via `MuxSender.open(url, program_config)`. Send methods accept any
    bytes-like input (`bytes`, `bytearray`, `memoryview`, NumPy `uint8`).
    `pts` is keyword-only on every send method. The muxer + transport work
    runs with the GIL released. After ``cancel_handle().cancel()`` every
    send method raises ``CLOSED``, buffered data included.
    """

    @classmethod
    def open(
        cls,
        url: str,
        program_config: MuxerProgramConfig,
        *,
        cancel: Optional[OpenCancel] = ...,
    ) -> MuxSender:
        """`cancel`: an `OpenCancel` already cancelled raises the transport's
        `CLOSED`; one cancelled during the connect does not interrupt it, but
        the open then raises `CLOSED` and the connection is closed again."""

    # Send surface — single stream.
    def send_video(
        self,
        nal: _BytesLike,
        *,
        pts: Pts90khz,
        key_frame: bool = ...,
    ) -> None: ...
    def send_klv(
        self,
        klv: _BytesLike,
        *,
        pts: Pts90khz,
        metadata_service_id: int = ...,
    ) -> None: ...
    def send_audio(self, adts: _BytesLike, *, pts: Pts90khz) -> None: ...
    def send_subtitle(self, payload: _BytesLike, *, pts: Pts90khz) -> None: ...
    def send_data(self, data: _BytesLike, *, pts: Pts90khz) -> None: ...

    # Send surface — multi-stream variants (explicit handle).
    def send_video_to(
        self,
        handle: VideoStreamHandle,
        nal: _BytesLike,
        *,
        pts: Pts90khz,
        key_frame: bool = ...,
    ) -> None: ...
    def send_klv_to(
        self,
        handle: KlvStreamHandle,
        klv: _BytesLike,
        *,
        pts: Pts90khz,
        metadata_service_id: int = ...,
    ) -> None: ...
    def send_audio_to(
        self,
        handle: AudioStreamHandle,
        adts: _BytesLike,
        *,
        pts: Pts90khz,
    ) -> None: ...
    def send_subtitle_to(
        self,
        handle: SubtitleStreamHandle,
        payload: _BytesLike,
        *,
        pts: Pts90khz,
    ) -> None: ...
    def send_data_to(
        self,
        handle: DataStreamHandle,
        data: _BytesLike,
        *,
        pts: Pts90khz,
    ) -> None: ...

    # Stream handle accessors (first-of-kind).
    def video_handle(self) -> Optional[VideoStreamHandle]: ...
    def klv_handle(self) -> Optional[KlvStreamHandle]: ...
    def audio_handle(self) -> Optional[AudioStreamHandle]: ...
    def subtitle_handle(self) -> Optional[SubtitleStreamHandle]: ...
    def data_handle(self) -> Optional[DataStreamHandle]: ...

    def stats(self) -> Tuple[SocketStats, MuxerStats]: ...
    def cancel_handle(self) -> CancelHandle: ...
    def close(self) -> None: ...
    def finish(self) -> None:
        """Drain pending bytes to the transport, raise the first drain error
        (the transport's error class), then close.
        The sender is closed either way; a second ``finish()`` is a no-op
        unless the sender has been cancelled (after a cancel every
        ``finish()`` raises ``CLOSED``, a repeated one included). A
        ``finish()`` after ``close()`` is a no-op too. It does NOT free the
        handle — call ``close()`` (or use the ``with`` block) to release it.
        Unlike ``close()`` this does not cancel a parked send first.
        After ``cancel_handle().cancel()`` this raises ``CLOSED``, buffered
        data included."""
    def is_alive(self) -> bool: ...
    def __enter__(self) -> MuxSender: ...
    def __exit__(
        self,
        exc_type: Optional[Type[BaseException]],
        exc_value: Optional[BaseException],
        traceback: Optional[Any],
    ) -> bool: ...
    def __repr__(self) -> str: ...


@final
class DemuxReceiver:
    """`Receiver` + `Demuxer` constructed together, opened from any
    transport's URL.

    Construct via `DemuxReceiver.open(url, demux_config=None)`. For an
    `srt://` URL the mode must be `listener`. Iterating yields
    `tstrans.mpegts.DemuxEvent` subclass instances — no duplicated
    event type hierarchy. `__next__` blocks (releases the GIL) on the
    underlying transport read.

    `stats()` returns the receive counters as a `DemuxReceiverStats`;
    the wire counters are `socket_stats()`.

    An `srt://` bind or accept fault raises `SrtError(kind=BROKEN)` with
    the message prefixed `bind: ` or `accept: `. The `srt://` open blocks
    in its first accept; an `OpenCancel` passed as `cancel=` ends it from
    another thread with `SrtError(CLOSED)`.
    """

    @classmethod
    def open(
        cls,
        url: str,
        demux_config: Optional[DemuxerConfig] = ...,
        *,
        cancel: Optional[OpenCancel] = ...,
    ) -> DemuxReceiver: ...
    def __iter__(self) -> Iterator[DemuxEvent]: ...
    def __next__(self) -> DemuxEvent:
        """After ``cancel_handle().cancel()`` this raises ``CLOSED``, buffered data included."""
    def cancel_handle(self) -> CancelHandle: ...
    def socket_stats(self) -> SocketStats: ...
    def ts_bytes_demuxed(self) -> int:
        """Aligned TS bytes the demuxer was fed; the last value after `close()`."""
    def stats(self) -> DemuxReceiverStats:
        """The receive counters by name. Waits behind a ``__next__`` parked
        on another thread; raises the transport's ``CLOSED`` kind after
        ``close()``. A record taken earlier keeps its values."""
    def rtp_stats(self) -> Optional[RtpStats]:
        """The RTP counters of a receiver over ``rtp://`` or an RTSP
        session; ``None`` on any other transport. Never waits behind a call
        parked on another thread; the last value after ``close()``."""
    def last_seen(self, pid: int) -> Optional[datetime.datetime]:
        """When ``pid`` last carried an item through this receiver, as a
        UTC-aware ``datetime``; ``None`` for a PID never seen. Waits behind
        a ``__next__`` parked on another thread; raises the transport's ``CLOSED`` kind after
        ``close()``."""
    def last_seen_micros(self, pid: int) -> Optional[int]:
        """``last_seen(pid)`` in microseconds since the Unix epoch.
        Deprecated: warns ``DeprecationWarning``; removed in 0.12.0."""
    def end_reason(self) -> Optional[EndReason]:
        """The recorded reason, or `None` while the stream is live. Every plain
        receive transport records one."""
    def end_detail(self) -> Optional[str]: ...
    def local_addr(self) -> Optional[Tuple[str, int]]:
        """``(host, port)`` the open bound: a ``udp://``, ``rist://@`` or
        ``rtp://`` bind (the kernel's port when the URL named 0), or an
        ``srt://`` listener once its caller connected (so port 0 cannot
        tell an ``srt://`` caller where to dial). ``None`` for a shell
        whose open records none (a caller, an accepted TCP connection).
        Never waits behind a call parked on another thread; raises the
        transport's ``CLOSED`` once closed."""
    def local_port(self) -> Optional[int]:
        """The port of ``local_addr()``; same rules."""
    def peer_addr(self) -> Optional[Tuple[str, int]]:
        """``(host, port)`` of the sender whose datagram (``udp://``) or
        block (``rist://``) was delivered last; ``None`` until the first
        one, and always ``None`` for a transport that keeps no source
        record (``srt://``, ``tcp://``, ``rtp://``). The host is the IP as
        text (an IPv6 link-local sender's host carries its scope,
        ``fe80::1%2``); an IPv4 sender on a dual-stack bind reads as IPv4.

        It is the source address of the datagrams, which nothing verifies:
        a UDP or RIST sender can forge it. Without a ``source`` key in the
        URL every sender that reaches the receiver is delivered, and this
        names whichever delivered last. Never waits behind a call parked
        on another thread; the last value after ``close()``."""
    def source_rejected(self) -> int:
        """Datagrams or blocks the ``source`` key of a ``udp://`` or
        ``rist://`` URL turned away (``source=<ip>`` admits that IP on any
        port, ``source=first`` the IP of the first delivery until close);
        on ``udp://`` they appear in no received counter. 0 for a
        transport that keeps no source record. Never waits behind a call
        parked on another thread; the last value after ``close()``."""
    def close(self) -> None: ...
    def is_alive(self) -> bool: ...
    def __enter__(self) -> DemuxReceiver: ...
    def __exit__(
        self,
        exc_type: Optional[Type[BaseException]],
        exc_value: Optional[BaseException],
        traceback: Optional[Any],
    ) -> bool: ...
    def __repr__(self) -> str: ...
