"""Type stubs for `tstrans.webrtc` — WebRTC (WHEP) browser playback.

Mirrors the `WhepServer`, `MountHandle`, `SessionStats`, `ServerStats` and
`MountStats` PyClass-backed types exported from
`bindings/python/src/webrtc/`, and the pure-Python `MountConfig` dataclass
with its `MountKind`, `AudioPolicy` and `KlvCarriage` enums.

``WebrtcError`` and ``WebrtcErrorKind`` live in ``tstrans.exceptions`` and
are re-exported here for convenience.

mypy --strict clean.
"""

from __future__ import annotations

import enum
from dataclasses import dataclass
from types import TracebackType
from typing import Any, Optional, Union, final

from .exceptions import WebrtcError as WebrtcError
from .exceptions import WebrtcErrorKind as WebrtcErrorKind
from .mpegts import Pts90khz, VideoCodec

# A bytes-like input — `bytes`, `bytearray`, `memoryview`, NumPy uint8, or
# any object implementing the buffer protocol.
_BytesLike = Union[bytes, bytearray, memoryview, Any]

__all__: list[str] = [
    "WhepServer",
    "MountHandle",
    "MountConfig",
    "MountKind",
    "AudioPolicy",
    "KlvCarriage",
    "ServerStats",
    "MountStats",
    "SessionStats",
    "WebrtcError",
    "WebrtcErrorKind",
]

# ---------------------------------------------------------------------------
# Mount configuration
# ---------------------------------------------------------------------------

class MountKind(enum.IntEnum):
    """What a mount is fed with."""

    ELEMENTARY = 0
    MP2T = 1

class AudioPolicy(enum.IntEnum):
    """What a mount does with audio."""

    DROP = 0
    PASSTHROUGH_OPUS = 1

class KlvCarriage(enum.IntEnum):
    """Where a mount carries its KLV records."""

    SEI_AND_DATA_CHANNEL = 0
    SEI_ONLY = 1
    DATA_CHANNEL_ONLY = 2

@dataclass(frozen=True)
class MountConfig:
    """How one mount is fed and what it sends; the defaults are the Rust
    ``MountConfig::default()``. Validated by ``WhepServer.add_mount``."""

    kind: MountKind = ...
    video: VideoCodec = ...
    audio: AudioPolicy = ...
    klv: KlvCarriage = ...
    sei_budget_bytes: int = ...
    viewer_queue_packets: int = ...

