# ---------------------------------------------------------------------------
# Server and mounts
# ---------------------------------------------------------------------------

@final
class MountHandle:
    """The push side of one mount, returned by ``WhepServer.add_mount``.

    Pushes never block: a full queue drops the frame and counts it.
    ``close()`` frees only this handle; the mount keeps serving until
    ``WhepServer.remove_mount``, ``stop()`` or ``close()``.
    """

    def push_video(self, au: _BytesLike, *, pts: Pts90khz, key_frame: bool) -> None:
        """Push one Annex-B access unit (elementary mounts). ``key_frame`` is
        advisory: the NAL units decide."""
    def push_klv(
        self, record: _BytesLike, *, pts: Pts90khz, metadata_service_id: int = ...
    ) -> None:
        """Push one KLV record (elementary mounts); it rides the first frame
        pushed at or after ``pts``. A record over 256 KiB, the data-channel
        limit, raises ``WebrtcError(PUSH)``. ``metadata_service_id``
        (0..=255, else ``ValueError``) is accepted and ignored."""
    def push_audio(self, frames: _BytesLike, *, pts: Pts90khz) -> None:
        """Push one Opus packet (elementary mounts); dropped and counted
        under ``AudioPolicy.DROP``."""
    def push_ts(self, data: _BytesLike) -> None:
        """Push MPEG-TS bytes (MP2T mounts)."""
    def stats(self) -> MountStats: ...
    def sessions(self) -> list[SessionStats]: ...
    def mount_path(self) -> str: ...
    def close(self) -> None: ...

@final
class WhepServer:
    """A WHEP server: browsers POST an SDP offer to a mount's path and play
    it over WebRTC. Construct with ``WhepServer.bind(url)``.

    ``stop()`` is idempotent and bounded; ``close()`` is ``stop()`` plus
    releasing the server, after which every method raises
    ``WebrtcError(CLOSED)``. Usable as a context manager (exit = close).
    """

    @staticmethod
    def bind(url: str) -> WhepServer: ...
    def add_mount(self, path: str, config: Optional[MountConfig] = None) -> MountHandle: ...
    def remove_mount(self, path: str) -> None: ...
    def stats(self) -> ServerStats: ...
    def local_addr(self) -> str: ...
    def media_addr(self) -> str: ...
    def stop(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> WhepServer: ...
    def __exit__(
        self,
        exc_type: Optional[type[BaseException]] = None,
        exc_value: Optional[BaseException] = None,
        traceback: Optional[TracebackType] = None,
    ) -> bool: ...
