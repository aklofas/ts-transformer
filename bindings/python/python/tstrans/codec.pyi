"""Type stubs for tstrans.codec — see codec.py for the runtime + full docstrings.

Covers the shared codec enums and value types (ChromaFormat, colour signalling,
Rational, ColorInfo), the typed NAL / OBU wrappers, the per-codec parameter-set
and slice-header-light classes (H.264 / H.265 / H.266), the AV1 sequence /
frame-header classes, the AAC + MPEG-2 audio frame classes and their iterators,
all the parse_* / iter_* functions, and the raw-first split_units / parse_audio
entry points (v0.2.0 item #1).

The *_np properties (payload_np / raw_rbsp_np / raw_np) are attached at runtime
by codec.py and return numpy.ndarray; they are typed Any here so the stubs never
import numpy (which is an optional [pandas] extra).

mypy --strict clean.
"""
from __future__ import annotations

from typing import TYPE_CHECKING, Any, Dict, List, Optional, Tuple, Union, final

if TYPE_CHECKING:
    from tstrans.mpegts import Av1CarriageMode

# Bytes-like input accepted by the parsers. PyO3's &[u8] extractor takes any
# buffer-protocol object; the raw-first entry points also accept SharedBytes-
# backed views. Typed broadly to match that runtime flexibility. Private
# (leading underscore) so stubtest doesn't treat it as a public runtime member.
_BytesLike = Union[bytes, bytearray, memoryview]

# --- shared enums (PyO3 eq_int #[pyclass] — plain classes, members are
#     instances of the class itself; NOT enum.IntEnum) ---

